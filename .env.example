# Hosbah — local development. Copy to .env and fill the two secrets (commands below).
APP_ENV=development
APP_URL=http://localhost:3710
ADDR=:8710

DB_DRIVER=pgx
# Always the non-superuser cloudy_app role (see docker-compose.yml): RLS does not bind a superuser.
# (The database, role and volume keep their names from before the rename: they name existing data.)
DATABASE_URL=postgres://cloudy_app:cloudy_app_dev@localhost:55491/cloudy?sslmode=disable
DEV_DATABASE_URL=postgres://cloudy_app:cloudy_app_dev@localhost:55491/cloudy_atlas_dev?sslmode=disable
TEST_DATABASE_URL=postgres://cloudy_app:cloudy_app_dev@localhost:55491/cloudy_test?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=text
LOCALE=en
LOCALE_DIR=lang
CACHE_DRIVER=memory
STORAGE_DIR=storage

# togo auth (base driver: JWT + bcrypt, cookie sessions). >= 32 bytes:  openssl rand -hex 32
AUTH_DRIVER=base
AUTH_SECRET=
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
CORS_ORIGINS=http://localhost:3710

# Hosbah's own settings are HOSBAH_*. The names from before the rename (CLOUDY_*) are still read when the
# HOSBAH_ one is not set, so an existing .env keeps working; new ones should use HOSBAH_*.

# Envelope-encryption KEK: 32 random bytes, base64:  openssl rand -base64 32
# Production: put it in a file only the service user can read and set HOSBAH_KEK_FILE instead.
HOSBAH_KEK=
# HOSBAH_KEK_FILE=/etc/hosbah/kek

# Where invitation accept links point.
HOSBAH_WEB_ORIGIN=http://localhost:3710

# The origin servers' agents reach the control plane at: the install one-liner, the binary download
# and the agent WebSocket (/agent/ws) all derive from it. With a local Docker container as the
# target server: http://host.docker.internal:8710. Production: https://app.hosbah.com
HOSBAH_AGENT_URL=http://localhost:8710
# Built agent binaries served at /agent/download (`make agent` writes them here).
HOSBAH_AGENT_DIST=bin/agent

# Apps domain: every app gets <prefix><app>.<domain> (pre-verified), e.g. hosbah-app-shop.example.com, or
# shop.hosbah.com with an empty prefix. Unset HOSBAH_APPS_DOMAIN to turn it off. With a Cloudflare API token (Zone:DNS:Edit on that zone) Hosbah
# also creates and deletes the DNS records; without one, point a wildcard record at your servers.
# HOSBAH_APPS_DOMAIN=hosbah.com
# HOSBAH_APPS_PREFIX=hosbah-app-
# HOSBAH_APPS_TLS=auto
# HOSBAH_APPS_PROXIED=false
# HOSBAH_CLOUDFLARE_TOKEN=

# Account email (verification, password reset and sign-in codes) over SMTP. Unset MAIL_HOST or
# MAIL_FROM and nothing is sent (the flows still answer; the codes just never arrive).
# MAIL_ENCRYPTION: starttls (587) | tls (465, implicit) | none (local relay only); default by port.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_FROM_NAME=Hosbah
# MAIL_ENCRYPTION=starttls
# Local development only: log each email (codes included) instead of sending it. Ignored when
# APP_ENV=production.
DEV_MAIL_LOG=1

# Reverse proxies whose X-Forwarded-For is trusted for the per-client rate limits on sign-up and
# code entry (comma-separated CIDRs or addresses). Unset: the connecting address is the client.
# HOSBAH_TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16

# Mahaam Feedback: backend errors and panics are filed as issues (MH-n) in Hosbah's Mahaam project.
# The key is public by design (it only files issues, from the allowed origins). Unset = off.
MAHAAM_URL=https://console.mahaam.app
MAHAAM_FEEDBACK_KEY=pfk_19fa8086ed238cd7af79385fea717b18
# A URL on one of the key's allowed origins (https://app.hosbah.com, https://hosbah.com, localhost:3710/3711).
MAHAAM_APP_URL=https://app.hosbah.com
