# Hosbah control-plane Go API — production image. Static binary (pgx is pure Go).
# Built on the workstation and docker-load'ed into Proxmox LXC 117.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
WORKDIR /app
COPY --from=build /out/api /app/api
COPY lang ./lang
COPY togo.yaml ./togo.yaml
COPY bin/agent ./bin/agent
RUN mkdir -p storage && chown -R app:app /app
USER app
EXPOSE 8710
CMD ["/app/api"]
