# Self-host settings for docker-compose.selfhost.yml. Copy to .env.selfhost and fill in the secrets.
# Generate each secret with:  openssl rand -base64 32
POSTGRES_PASSWORD=
HOSBAH_APP_DB_PASSWORD=
# >= 32 bytes, e.g. openssl rand -hex 32
AUTH_SECRET=
# 32 random bytes, base64 (envelope-encryption key; back it up: without it sealed data is unreadable)
HOSBAH_KEK=

# Public origin of the web app (the API is proxied under /api).
APP_URL=http://localhost:3710
# The origin your managed servers reach the control plane at (agent install, /agent/ws).
HOSBAH_AGENT_URL=http://localhost:8710
# 1 behind HTTPS.
COOKIE_SECURE=0
WEB_PORT=3710
API_PORT=8710
