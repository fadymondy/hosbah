{
  "name": "hosbah-apps",
  "private": true,
  "description": "Hosbah companion clients: the shared API client and the desktop tray app. The mobile app has its own lockfile, like Mahaam's.",
  "workspaces": [
    "shared",
    "desktop"
  ],
  "scripts": {
    "gen:types": "npm run gen:types -w @hosbah/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "desktop": "npm run dev -w @hosbah/desktop"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
