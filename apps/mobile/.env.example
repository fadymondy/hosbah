# Copy to .env.local. Nothing here is a secret.

# Default server the sign-in screen starts with (users can change it in the app).
# EXPO_PUBLIC_API_URL=https://app.hosbah.com

# Dev-only: serve fixture data (team "Demo") instead of calling a server. Used for screenshots.
# EXPO_PUBLIC_MOCK=1

# iOS push environment written to the entitlements at prebuild: development | production (default).
# APS_ENVIRONMENT=development
