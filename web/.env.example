# The Go API origin the Next.js server proxies /api/* to. The browser only ever
# talks to this app (same origin), so the togo session + CSRF cookies just work.
API_ORIGIN=http://localhost:8710

# Where MCP clients reach the API directly (shown in token snippets). Build-time.
NEXT_PUBLIC_MCP_ORIGIN=http://localhost:8710
# Mahaam's Feedback SDK: "Report a problem" files an MH-n issue into the Hosbah project in Mahaam.
# Public values (the key only files issues, from its allowed origins). Empty = in-app dialog.
NEXT_PUBLIC_MAHAAM_URL=https://console.mahaam.app
NEXT_PUBLIC_MAHAAM_FEEDBACK_KEY=pfk_19fa8086ed238cd7af79385fea717b18
# Extra hosts allowed to load the dev server (comma separated), e.g. a tunnel hostname.
DEV_ORIGINS=
