# Hosbah control plane — Proxmox LXC 117. Copy to .env.prod on the LXC and fill in.
# DB is pg-shared (LXC 102, 10.10.10.102:5432).
# IMPORTANT: reuse the SAME KEK and AUTH_SECRET as the previous deployment (an .env.prod from
# before the rename that still says CLOUDY_KEK works as it is: CLOUDY_* is read when HOSBAH_* is unset),
# otherwise the ops signing key changes (enrolled agents must re-enrol) and sealed
# team DEKs no longer decrypt.
APP_ENV=production
APP_URL=https://app.hosbah.com
ADDR=:8710

DB_DRIVER=pgx
# Single non-superuser role that owns the schema; tables use FORCE RLS so the owner
# is still bound by tenant policies. Do NOT grant BYPASSRLS. The role and database keep their names
# from before the rename (cloudy_app, cloudy): they are the existing data.
DATABASE_URL=postgres://cloudy_app:__APP_PASSWORD__@10.10.10.102:5432/cloudy?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=text
LOCALE=en
LOCALE_DIR=lang
CACHE_DRIVER=memory
STORAGE_DIR=storage

AUTH_DRIVER=base
AUTH_SECRET=__AUTH_SECRET__
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=1
CORS_ORIGINS=https://app.hosbah.com

HOSBAH_KEK=__BASE64_32B_KEK__
HOSBAH_WEB_ORIGIN=https://app.hosbah.com
HOSBAH_AGENT_URL=https://app.hosbah.com
HOSBAH_AGENT_DIST=bin/agent
HOSBAH_DB_BIND=172.18.0.1

# Account email (verification, password reset and sign-in codes). Required in production: without
# it new sign-ups cannot verify their address. MAIL_ENCRYPTION: starttls (587) | tls (465) | none.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Hosbah
# MAIL_ENCRYPTION=starttls
# Never set DEV_MAIL_LOG here: it would log codes, and it is refused when APP_ENV=production.

# The proxies in front of the API (the web container and the reverse proxy), so per-client rate
# limits see the real client from X-Forwarded-For instead of one shared proxy address.
# HOSBAH_TRUSTED_PROXIES=172.18.0.0/16

# Mahaam Feedback: backend errors and panics are filed as issues (MH-n) in Hosbah's Mahaam project.
# The key is public by design (it only files issues, from the allowed origins). Unset = off.
MAHAAM_URL=https://console.mahaam.app
MAHAAM_FEEDBACK_KEY=pfk_19fa8086ed238cd7af79385fea717b18
# A URL on one of the key's allowed origins (https://app.hosbah.com, https://hosbah.com, localhost:3710/3711).
MAHAAM_APP_URL=https://app.hosbah.com
